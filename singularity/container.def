Bootstrap: {{ bootstrap }}
From: {{ docker_image }}

%arguments
    bootstrap=docker
    docker_image=lunjohnzhang/lsmart:latest
    version=dev

%labels
    org.opencontainers.image.title LSMART
    org.opencontainers.image.version {{ version }}
    org.opencontainers.image.source https://github.com/smart-mapf/lifelong-smart
    org.opencontainers.image.description LSMART converted from its canonical Docker image

%test
    test -x /usr/project/server/build/ExecutionManager
    test -x /usr/project/planner/PBS/build/pbs
    test -x /usr/project/planner/Transient_PBS/build/tpbs
    test -x /usr/project/planner/RHCR/build/lifelong
    test -f /usr/project/plugins/visualizers/external_visualizer/build/libexternal_visualizer.so
    test -f /usr/project/web/lsmart-visualiser/dist/index.html
    test "$(python3 -c 'import sys; print(sys.version_info[:2])')" = "(3, 8)"
    lsmart-viz --help >/dev/null

%runscript
    exec /usr/local/bin/lsmart-viz "$@"

%help
    This SIF is a direct conversion of the LSMART Docker image.

    Run the web visualizer:
      apptainer run container.sif

    Run without visualization:
      apptainer exec container.sif python3 /usr/project/run_lifelong.py \
        /usr/project/maps/kiva_large_w_mode.json --visualizer none --container True

    Run the native ARGoS visualizer from a graphical session:
      apptainer exec container.sif python3 /usr/project/run_lifelong.py \
        /usr/project/maps/kiva_large_w_mode.json --visualizer argos --container True
